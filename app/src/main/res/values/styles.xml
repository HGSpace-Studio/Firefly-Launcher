<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_bottom_bar</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:fontFamily">@font/harmonyos_sans_regular</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="preferenceTheme">@style/FireflyPreferenceTheme</item>
        <!-- Global dialog style: rounded corners + semi-transparent dark -->
        <item name="android:alertDialogTheme">@style/FireflyDialogTheme</item>
        <item name="alertDialogTheme">@style/FireflyDialogTheme</item>
    </style>

    <!-- Rounded semi-transparent dialog -->
    <style name="FireflyDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@drawable/dialog_background</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">65%</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="colorAccent">#5AC8FA</item>
        <item name="android:buttonStyle">@style/FireflyDialogButton</item>
    </style>

    <!-- Dialog button: transparent with text color -->
    <style name="FireflyDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#5AC8FA</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/harmonyos_sans_regular</item>
    </style>

    <!-- Use default Material preference layouts to avoid crashes -->
    <style name="FireflyPreferenceTheme" parent="PreferenceThemeOverlay.v14.Material">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>
    
    <style name="ThickDivider">
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>

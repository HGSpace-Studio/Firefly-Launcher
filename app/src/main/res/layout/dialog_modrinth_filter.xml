<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_heavy">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="筛选条件"
        android:textSize="@dimen/_16ssp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/padding_heavy" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Minecraft 版本"
        android:textSize="@dimen/_13ssp"
        android:layout_marginBottom="@dimen/padding_small" />

    <TextView
        android:id="@+id/modrinth_selected_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未选择"
        android:textSize="@dimen/_12ssp"
        android:padding="@dimen/padding_medium"
        android:background="@drawable/background_line"
        android:layout_marginBottom="@dimen/padding_medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/padding_heavy">

        <Button
            android:id="@+id/modrinth_select_version_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择版本"
            android:layout_marginEnd="@dimen/padding_medium" />

        <Button
            android:id="@+id/modrinth_clear_version_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清除" />

    </LinearLayout>

    <Button
        android:id="@+id/modrinth_apply_filter_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="应用筛选" />

</LinearLayout>
